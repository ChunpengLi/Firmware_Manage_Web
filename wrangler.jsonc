{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firmware-manage-web",
  "main": "pcs-upgrade-server/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./pcs-upgrade-server/wwwroot",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firmware-manage-db",
      "database_id": "321a88d4-7f9a-4663-a625-83339fe074b5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "firmware-manage-files"
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "HS"
  },
  "routes": [{ "pattern": "cpeng.uk", "custom_domain": true }]
}
